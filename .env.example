APP_NAME="Prima Backend"
APP_VERSION="0.1.0"
DEBUG=True
ENVIRONMENT=development

API_PREFIX=/api/v1

DATABASE_URL=postgresql+asyncpg://primaadmin:your_password@localhost:5432/primadb
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_ECHO=False

HOST=0.0.0.0
PORT=8001
WORKERS=4

CORS_ORIGINS=["http://localhost:3000"]
CORS_ALLOW_CREDENTIALS=True
CORS_ALLOW_METHODS=["*"]
CORS_ALLOW_HEADERS=["*"]

# JWT Settings
JWT_SECRET_KEY=prima-secret-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
