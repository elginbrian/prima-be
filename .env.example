APP_NAME="Prima Backend"
APP_VERSION="0.1.0"
# Production: DEBUG=False and ENVIRONMENT=production (app refuses to boot with a weak JWT secret)
DEBUG=True
ENVIRONMENT=development

API_PREFIX=/api/v1

DATABASE_URL=postgresql+asyncpg://primaadmin:your_password@localhost:5432/primadb
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_ECHO=False

HOST=0.0.0.0
PORT=8001
WORKERS=4

CORS_ORIGINS=["http://localhost:3000"]
CORS_ALLOW_CREDENTIALS=True

# JWT Settings — generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-use-at-least-32-random-characters
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# AWS S3 (guarantee document storage)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-southeast-1
S3_BUCKET_NAME=prima-storage-local

# AI extraction (OCR)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Local dev only: return fake data when GEMINI_API_KEY is empty
ALLOW_MOCK_AI=False

# Upload limit (MB)
MAX_UPLOAD_MB=10
